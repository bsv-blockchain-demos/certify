# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=8080

# BSV Wallet Configuration
SERVER_PRIVATE_KEY=your_server_private_key_here
WALLET_STORAGE_URL=https://store-us-1.bsvb.tech
CHAIN=main

# Optional: Logging Configuration
LOG_LEVEL=info

# Float treasury monitoring: bearer token for GET /treasury/balance.
# Absent = the route is not mounted. Production value ships via the
# certify-secrets ExternalSecret (/apps/certify/FLOAT_BALANCE_TOKEN).
FLOAT_BALANCE_TOKEN=
